<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gpio_config" params="prefix">
    <gpio name="${prefix}gpio">
      <command_interface name="${prefix}_command_01" data_type="BOOL">
        <limits enable="false"/>
        <param name="initial_value">0.0</param>
      </command_interface>

      <state_interface name="${prefix}_state_01" data_type="BOOL">
        <limits enable="false"/>
        <param name="initial_value">0.0</param>
      </state_interface>
    </gpio>
  </xacro:macro>
</robot>
